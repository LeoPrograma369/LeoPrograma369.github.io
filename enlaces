    <script>
        const themeToggler = document.getElementById('themeToggler');
        const htmlElement = document.documentElement;

        // Comprobación de preferencia del sistema o almacenamiento del usuario
        const currentStoredTheme = localStorage.getItem('hub-theme');
        const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

        if (currentStoredTheme === 'dark' || (!currentStoredTheme && systemPrefersDark)) {
            htmlElement.setAttribute('data-bs-theme', 'dark');
        } else {
            htmlElement.setAttribute('data-bs-theme', 'light');
        }

        // Manejador del evento clic con persistencia
        themeToggler.addEventListener('click', () => {
            const currentActiveTheme = htmlElement.getAttribute('data-bs-theme');
            let newTheme = 'light';
            
            if (currentActiveTheme === 'light') {
                newTheme = 'dark';
            }
            
            htmlElement.setAttribute('data-bs-theme', newTheme);
            localStorage.setItem('hub-theme', newTheme);
        });
    </script>
